# Copie este arquivo para ".env" e preencha com as chaves do SEU projeto Firebase.
# Você encontra tudo em: Console do Firebase > Configurações do projeto > Seus apps > Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

