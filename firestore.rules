rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só quem passou pela tela de senha entra (login anônimo do Firebase).
    // É uma panela: todo mundo autenticado pode ler e escrever a lista e o sorteio.
    match /jogadores/{id} {
      allow read, write: if request.auth != null;
    }
    match /estado/{id} {
      allow read, write: if request.auth != null;
    }
    match /historico/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
